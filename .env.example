# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=etl_db

# Internal service URLs
ETL_BASE_URL=http://etl_service:8000
RAG_BASE_URL=http://rag_service:8000
OBS_BASE_URL=http://observability_service:8000
AGENT_BASE_URL=http://agent_service:8000
SERVICE_TIMEOUT_SECONDS=60

# RAG storage and local embeddings
CHROMA_DIR=app/chroma_store
RAG_UPLOAD_DIR=app/uploads
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM provider. Use none/local for free retrieval-only answers, or openai.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5

# Bounded agent execution
AGENT_MAX_TOOL_ITERATIONS=1
AGENT_MAX_TOOL_CALLS=4
AGENT_RECURSION_LIMIT=12
